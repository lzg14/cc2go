# cc2go 配置模板
# 复制此文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）

# OpenCode Go API 配置
OPENCODE_BASE_URL=https://opencode.ai/zen/go
OPENCODE_API_KEY=your-api-key-here

# Router 服务配置
ROUTER_HOST=0.0.0.0
ROUTER_PORT=4000
ROUTER_MASTER_KEY=sk-your-master-key

# 重试配置
MAX_RETRY=3
RETRY_DELAY=1.0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/router.log

# 日志详细程度（true 打印请求/响应详情，false 只打印摘要）
DETAILED_LOGGING=true

# 禁用思考模式（一些模型会默认输出 reasoning_content）
DISABLE_THINKING=true

# 默认选中模型（留空则使用客户端传来的模型名）
SELECTED_MODEL=

# Claude Code 中显示的模型别名（留空=使用实际模型名，设成 claude-sonnet-4 可放开图片发送）
CLAUDE_MODEL_ALIAS=

# Claude Code 配置文件路径（用于自动同步模型名和连接信息）
CLAUDE_SETTINGS_PATH=~/.claude/settings.json

# 错误归档目录（留空使用默认 <项目根>/error-archive）
ERROR_ARCHIVE_DIR=

# 错误归档间隔（秒，同类型错误至少间隔 N 秒才再次归档）
ERROR_ARCHIVE_INTERVAL=30
